---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
const bindings = env as unknown as Record<string, string | undefined>;
---
<BaseLayout title="অ্যাডমিন প্যানেল | Rannaghor BD" description="Rannaghor BD রেসিপি পরিচালনা ও বাল্ক ইমপোর্ট অ্যাডমিন প্যানেল।" canonical="/admin/" noindex={true}>
  <section class="admin-wrap"><div class="container"><div class="admin-hero"><div><span class="section-kicker">কনটেন্ট ম্যানেজমেন্ট</span><h1>অ্যাডমিন ড্যাশবোর্ড</h1><p>রেসিপি পরিচালনা করুন, নতুন কনটেন্ট যোগ করুন এবং বাল্ক ইমপোর্ট করুন।</p></div><a href="/" class="text-link">← ওয়েবসাইট দেখুন</a></div>
    <div id="admin-root" data-supabase-url={bindings.SUPABASE_URL || ''} data-supabase-anon-key={bindings.SUPABASE_ANON_KEY || ''}>
      <div class="notice" id="config-notice">ডেটাবেস সংযুক্ত না থাকলে অ্যাডমিন লগইন চালু হবে না। README-তে সেটআপের ধাপ দেখুন।</div>
      <div class="admin-panel" id="login-panel" style="max-width:520px;margin:18px auto 0"><h2>অ্যাডমিন লগইন</h2><p class="panel-help">শুধু অনুমোদিত অ্যাডমিন অ্যাকাউন্ট ব্যবহার করুন। সাধারণ দর্শক এই প্যানেলে প্রবেশ করতে পারবেন না।</p><form id="login-form"><div class="field"><label for="admin-email">ইমেইল</label><input id="admin-email" type="email" autocomplete="username" required placeholder="admin@example.com"/></div><div class="field"><label for="admin-password">পাসওয়ার্ড</label><input id="admin-password" type="password" autocomplete="current-password" required placeholder="আপনার পাসওয়ার্ড"/></div><button type="submit" class="button-primary">নিরাপদে লগইন করুন ↗</button><div id="login-message" class="status-message"></div></form></div>
      <div id="admin-console" class="hidden" style="margin-top:18px">
        <div class="admin-topbar"><div><h2 style="color:var(--green);margin:0">কনটেন্ট ম্যানেজমেন্ট</h2><p id="session-email" class="site-note"></p></div><button id="sign-out" class="button-secondary" type="button">লগআউট</button></div>
        <div class="admin-stat-grid"><div class="admin-stat"><strong id="published-count">—</strong><span>প্রকাশিত রেসিপি</span></div><div class="admin-stat"><strong id="draft-count">—</strong><span>খসড়া রেসিপি</span></div><div class="admin-stat"><strong>10,000+</strong><span>লক্ষ্য লাইব্রেরি</span></div></div>
        <section class="admin-panel recipe-library" id="recipe-library"><div class="admin-topbar"><div><h2>রেসিপি লাইব্রেরি</h2><p class="panel-help" style="margin:5px 0 0">সর্বশেষ ১০০টি রেসিপি সম্পাদনা, প্রকাশ বা মুছে ফেলুন।</p></div><button id="refresh-recipes" type="button" class="button-secondary">রিফ্রেশ ↻</button></div><div id="recipe-list" class="recipe-admin-list"><p class="site-note">রেসিপি লোড হচ্ছে…</p></div><div id="library-message" class="status-message"></div></section>
        <div class="admin-layout"><aside class="admin-sidebar"><h3>কনটেন্ট টুল</h3><a class="active" href="#add-recipe">নতুন রেসিপি</a><a href="#bulk-import">বাল্ক ইমপোর্ট</a><a href="#data-rules">ডেটা নিয়ম</a></aside><div class="admin-content" style="display:grid;gap:18px">
          <section class="admin-panel" id="add-recipe"><h2>নতুন রেসিপি যোগ করুন</h2><p class="panel-help">একটি রেসিপি লিখে খসড়া হিসেবে সংরক্ষণ করুন। প্রকাশের আগে উপকরণ, রান্নার নির্দেশনা ও কনটেন্টের অধিকার যাচাই করুন।</p><form id="recipe-form"><div class="field-grid"><div class="field"><label for="title_bn">রেসিপির বাংলা নাম *</label><input id="editing_id" type="hidden"/><input id="editing_status" type="hidden" value="draft"/><input id="title_bn" required maxlength="180" placeholder="যেমন: মুরগির ভুনা"/></div><div class="field"><label for="title_en">ইংরেজি নাম</label><input id="title_en" maxlength="180" placeholder="Homestyle Chicken Bhuna"/></div><div class="field"><label for="slug">URL slug *</label><input id="slug" required pattern="[a-z0-9-]+" placeholder="homestyle-chicken-bhuna"/><span class="field-hint">ইংরেজি ছোট হাতের অক্ষর, সংখ্যা ও হাইফেন ব্যবহার করুন।</span></div><div class="field"><label for="cuisine">রান্নার ধরন</label><input id="cuisine" placeholder="যেমন: বাংলাদেশি, ভারতীয়, আন্তর্জাতিক"/></div><div class="field"><label for="category">ক্যাটাগরি</label><input id="category" placeholder="যেমন: মাছ, ডেজার্ট, ভাত"/></div><div class="field"><label for="image_url">ছবির URL</label><input id="image_url" type="url" placeholder="https://…"/></div><div class="field"><label for="prep_time_minutes">প্রস্তুতি (মিনিট)</label><input id="prep_time_minutes" type="number" min="0" max="10080" value="10"/></div><div class="field"><label for="cook_time_minutes">রান্না (মিনিট)</label><input id="cook_time_minutes" type="number" min="0" max="10080" value="25"/></div><div class="field"><label for="servings">কতজনের জন্য</label><input id="servings" type="number" min="1" max="1000" value="4"/></div><div class="field"><label for="difficulty">কঠিনতা</label><select id="difficulty"><option>সহজ</option><option>মাঝারি</option><option>কঠিন</option></select></div><div class="field full"><label for="description_bn">সংক্ষিপ্ত বিবরণ</label><textarea id="description_bn" rows="2" placeholder="রেসিপির পরিচিতি ও বিশেষত্ব"></textarea></div><div class="field full"><label for="ingredients">উপকরণ * (প্রতি লাইনে একটি)</label><textarea id="ingredients" required placeholder="মুরগি ৭৫০ গ্রাম&#10;পেঁয়াজ কুচি ২ কাপ&#10;আদা-রসুন বাটা ২ টেবিল চামচ"></textarea></div><div class="field full"><label for="instructions">রান্নার ধাপ * (প্রতি লাইনে একটি ধাপ)</label><textarea id="instructions" required placeholder="মুরগি ধুয়ে মসলা মাখিয়ে রাখুন।&#10;কড়াইয়ে পেঁয়াজ ভেজে মসলা কষান।&#10;মুরগি দিয়ে সেদ্ধ হওয়া পর্যন্ত রান্না করুন।"></textarea></div><div class="field"><label for="license_name">কনটেন্ট লাইসেন্স/অধিকার *</label><input id="license_name" required placeholder="Original content / CC BY 4.0"/><span class="field-hint">যে অনুমতিতে এটি প্রকাশ করা যাবে তা লিখুন।</span></div><div class="field"><label for="source_url">মূল উৎস URL</label><input id="source_url" type="url" placeholder="https://source.example/recipe"/></div><div class="field"><label for="license_url">লাইসেন্সের URL</label><input id="license_url" type="url" placeholder="https://creativecommons.org/licenses/by/4.0/"/></div><div class="field"><label for="attribution">লেখক / attribution</label><input id="attribution" placeholder="লেখক বা উৎসের স্বীকৃতি"/></div></div><div class="form-actions"><button class="button-primary" type="submit">খসড়া সংরক্ষণ করুন ↗</button><button class="button-secondary" type="reset">ফর্ম পরিষ্কার</button></div><div id="recipe-message" class="status-message"></div></form></section>
          <section class="admin-panel" id="bulk-import"><h2>১০,০০০+ রেসিপির বাল্ক ইমপোর্ট</h2><p class="panel-help">CSV বা JSON থেকে একসঙ্গে অনেক রেসিপি আপলোড করুন। সিস্টেম ৫০টি করে ব্যাচে পাঠাবে, ডুপ্লিকেট slug আপডেট করবে এবং ডিফল্টভাবে সব নতুন রেসিপিকে খসড়া রাখবে।</p><div class="file-drop"><strong>ফাইল বেছে নিন</strong><span class="site-note">CSV বা JSON · বড় ফাইল ব্যাচ ধরে প্রক্রিয়া করা হবে</span><input id="import-file" type="file" accept=".csv,.json,application/json,text/csv"/><a class="text-link" href="/sample-data/recipes-template.csv" download>CSV টেমপ্লেট ডাউনলোড ↗</a></div><label class="checkbox-line"><input id="publish-after-import" type="checkbox"/><span>ইমপোর্টের পর প্রকাশ করুন — শুধু সম্পূর্ণ যাচাই করা রেসিপির ক্ষেত্রে নির্বাচন করুন।</span></label><div class="form-actions"><button id="start-import" type="button" class="button-primary">ইমপোর্ট শুরু করুন ↗</button><button id="cancel-import" type="button" class="button-secondary" disabled>থামান</button></div><div id="import-message" class="status-message"></div><pre id="import-log" class="import-log hidden" aria-live="polite"></pre></section>
          <section class="admin-panel" id="data-rules"><h2>ইমপোর্টের ডেটা নিয়ম</h2><p class="panel-help">প্রতিটি রেসিপিতে বাংলা নাম, অনন্য slug, উপকরণ, রান্নার ধাপ ও লাইসেন্স/অধিকারের তথ্য থাকতে হবে। উপকরণ ও ধাপ JSON array বা pipe (|) দিয়ে আলাদা লেখা হিসেবে দেওয়া যায়।</p><div class="notice">ডেটাসেটের লাইসেন্স, attribution, ছবি ব্যবহারের অনুমতি ও রেসিপির সঠিকতা নিশ্চিত না করে প্রকাশ করবেন না। AI-তৈরি কনটেন্টও সম্পাদনা ও যাচাই করতে হবে।</div></section>
        </div></div>
      </div>
    </div>
  </div></section>
  <script src="../../scripts/admin.ts"></script>
</BaseLayout>
