---
import BaseLayout from '../layouts/BaseLayout.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { getPublishedRecipes, hasDatabaseConfig } from '../lib/recipes';
const recipes = await getPublishedRecipes(8);
const demoMode = !hasDatabaseConfig();
const title = 'Rannaghor BD — ঘরোয়া রান্নার সহজ রেসিপি';
const description = 'বাংলাদেশি, ভারতীয় ও আন্তর্জাতিক খাবারের সহজ বাংলা রেসিপি, উপকরণ ও ধাপে ধাপে রান্নার নিয়ম খুঁজে নিন।';
---
<BaseLayout title={title} description={description} canonical="/">
  <div class="container">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <span class="eyebrow">স্বাদের গল্প শুরু হোক</span>
        <h1 id="hero-title">আজ কী রান্না হবে?<br/><span>স্বাদ থাকুক মনে।</span></h1>
        <p>ঘরোয়া খাবার থেকে নতুন পদের অনুপ্রেরণা—সহজ বাংলায় রেসিপি খুঁজে নিন, রান্না হোক আনন্দের।</p>
        <form class="search-form" action="/recipes/" method="get" role="search">
          <input type="search" name="q" placeholder="রেসিপি, খাবার বা উপকরণের নাম লিখুন…" aria-label="রেসিপি খুঁজুন" />
          <button type="submit">খুঁজুন ↗</button>
        </form>
        <div class="trust-row"><span><b>✓</b> সহজ ধাপে রান্না</span><span><b>✳</b> বাংলা নির্দেশনা</span><span><b>♡</b> সবার জন্য অনুপ্রেরণা</span></div>
      </div>
      <div class="hero-art" aria-label="সুস্বাদু খাবারের ছবি">
        <img class="hero-image" src="https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=1000&q=85" alt="রঙিন তাজা উপকরণ ও পরিবেশিত খাবার" fetchpriority="high" />
        <div class="floating-note"><span>✦</span> ঘরের স্বাদ, নতুন অনুপ্রেরণা</div>
      </div>
    </section>
  </div>

  <section class="section section-tight" aria-labelledby="categories-title">
    <div class="container">
      <div class="section-head"><div><span class="section-kicker">আপনার পছন্দের স্বাদ</span><h2 id="categories-title">কী ধরনের রান্না খুঁজছেন?</h2><p class="section-sub">নিজের পছন্দের ক্যাটাগরি থেকে শুরু করুন।</p></div><a class="text-link" href="/recipes/">সব রেসিপি দেখুন ↗</a></div>
      <div class="category-grid">
        <a class="category-card" href="/recipes/?cuisine=বাংলাদেশি"><span class="category-icon">🍲</span><span><strong>বাংলাদেশি</strong><small>ভুনা, ভর্তা, মাছ ও পিঠা</small></span></a>
        <a class="category-card" href="/recipes/?cuisine=ভারতীয়"><span class="category-icon">🍛</span><span><strong>ভারতীয়</strong><small>কারি, বিরিয়ানি ও নিরামিষ</small></span></a>
        <a class="category-card" href="/recipes/?cuisine=আন্তর্জাতিক"><span class="category-icon">🥗</span><span><strong>আন্তর্জাতিক</strong><small>বিশ্বজুড়ে জনপ্রিয় পদ</small></span></a>
        <a class="category-card" href="/recipes/?category=ডেজার্ট"><span class="category-icon">🍮</span><span><strong>মিষ্টি ও ডেজার্ট</strong><small>মিষ্টি, কেক ও ঠান্ডা খাবার</small></span></a>
      </div>
    </div>
  </section>

  {demoMode && <div class="container" style="margin-top:24px"><div class="notice">প্রিভিউ মোড: নিচের রেসিপি ও ছবিগুলো ডিজাইন দেখানোর নমুনা। লাইসেন্স-যাচাইকৃত আসল কনটেন্ট হিসেবে প্রকাশের আগে এগুলো বদলান এবং Supabase সংযোগ করুন।</div></div>}

  <section class="section" aria-labelledby="popular-title">
    <div class="container">
      <div class="section-head"><div><span class="section-kicker">রান্নার অনুপ্রেরণা</span><h2 id="popular-title">জনপ্রিয় রেসিপি</h2><p class="section-sub">আজকের মেনু সাজাতে বেছে নিন আপনার পছন্দের পদ।</p></div><a class="text-link" href="/recipes/">আরও রেসিপি ↗</a></div>
      {recipes.length > 0 ? <div class="recipe-grid">{recipes.slice(0,8).map((recipe) => <RecipeCard recipe={recipe} />)}</div> : <div class="empty-state"><h2>রেসিপি যোগের অপেক্ষায়</h2><p>ডেটাবেস সেটআপ হলে এখানে প্রকাশিত রেসিপিগুলো দেখা যাবে।</p><a class="button-link" href="/admin/">অ্যাডমিন প্যানেলে যান ↗</a></div>}
    </div>
  </section>

  <section class="section section-tight">
    <div class="container">
      <div class="discover-banner"><div class="discover-copy"><span class="section-kicker">নতুন কিছু রান্না করুন</span><h2>পরিচিত উপকরণে<br/>নতুন স্বাদের খোঁজ</h2><p>ফ্রিজে থাকা উপকরণ দিয়েই কী রান্না করা যায়? খুঁজে নিন সহজ আইডিয়া আর রান্নার ধাপ।</p><a class="button-link" href="/recipes/">রেসিপি ঘুরে দেখুন <span>↗</span></a></div><img class="discover-image" src="https://images.unsplash.com/photo-1498837167922-ddd27525d352?auto=format&fit=crop&w=1100&q=85" alt="তাজা সবজি ও রান্নার উপকরণ" loading="lazy" /></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><div><span class="section-kicker">কেন Rannaghor BD</span><h2>রান্না হোক আরও সহজ</h2><p class="section-sub">পরিকল্পিত, পরিষ্কার এবং কাজে লাগে এমন রেসিপি অভিজ্ঞতা।</p></div></div>
      <div class="value-grid">
        <article class="value-card"><span class="value-icon">◷</span><h3>সময় বুঝে বেছে নিন</h3><p>প্রস্তুতি ও রান্নার সময় দেখে ব্যস্ত দিনের জন্য উপযুক্ত রেসিপি বেছে নিন।</p></article>
        <article class="value-card"><span class="value-icon">☷</span><h3>ধাপে ধাপে নির্দেশনা</h3><p>উপকরণ ও রান্নার পদ্ধতি পরিষ্কারভাবে সাজানো থাকবে, যাতে অনুসরণ করা সহজ হয়।</p></article>
        <article class="value-card"><span class="value-icon">♡</span><h3>নতুন স্বাদের অনুপ্রেরণা</h3><p>বাংলাদেশি, ভারতীয় ও আন্তর্জাতিক রান্না এক জায়গায় খুঁজে দেখুন।</p></article>
      </div>
    </div>
  </section>
</BaseLayout>
